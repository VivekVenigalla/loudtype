{
  "name": "loudtype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.js",
    "start": "node server.js",
    "test": "node --test \"test/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json",
    "emotion2vec:setup": "python3 -m venv emotion2vec/.venv && emotion2vec/.venv/bin/pip install torch torchaudio funasr huggingface_hub",
    "emotion2vec": "emotion2vec/.venv/bin/python emotion2vec/service.py"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/comic-neue": "^5.3.0",
    "typescript": "^5.9.3"
  }
}
